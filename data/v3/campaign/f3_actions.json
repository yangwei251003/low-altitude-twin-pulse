  "actions": [
    {
      "id": "F3:separate_network",
      "title": "断开噪声，留下养分",
      "region_id": "F3",
      "prerequisites": [
        "I3:furnace_crawler"
      ],
      "target_minutes": [
        5,
        8
      ],
      "completion_text": "行动完成 · 养分线保留，共生体的回声可以分离。",
      "objectives": [
        {
          "id": "F3:separate_network:sample",
          "text": "对照工厂热记录，检查仍在受伤的菌根",
          "hint": "在菌谷低层读样本；发热来自重复脉冲，不能只归咎于工厂冷却。",
          "after": [],
          "events": [
            {
              "type": "inspect",
              "target_id": "F3:root_sample",
              "options": [
                "record"
              ]
            }
          ],
          "effects": [
            {
              "type": "discovery",
              "discovery_id": "F3:independent_feedback",
              "title": "停止工业抽取后仍有重复脉冲，伤害还有另一来源"
            }
          ]
        },
        {
          "id": "F3:separate_network:listen",
          "text": "让苓音说明菌网维生与传信的两条路径",
          "hint": "先确认哪条根在送养分，哪条在放大脉冲；不要一并烧断。",
          "after": [
            "F3:separate_network:sample"
          ],
          "events": [
            {
              "type": "talk",
              "target_id": "npc:lingyin",
              "options": [
                "network_paths"
              ]
            }
          ],
          "effects": [
            {
              "type": "dialogue",
              "character_id": "npc:lingyin",
              "lines": [
                "旧中枢把求援当成配额不足，于是越求援越抽取。我们保留养分根，只隔离那条放大声。"
              ]
            }
          ]
        },
        {
          "id": "F3:separate_network:isolate",
          "text": "维持一端，隔离重复信号根",
          "hint": "先选4光束，Tab锁定养分枝桥后按F照明；再选7生长，按恢复节奏按F三次，让桥完全长成并支撑两端。随后在信号保持端用G锁定旁路，或用9协作分身维持，再从侧面靠近重复信号开关，Tab锁定后按G断开；双人也可分头维持。养分桥、保持端与开关须同时有效。",
          "after": [
            "F3:separate_network:listen"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "F3:signal_isolation_verified",
              "options": [
                "echo_hold",
                "two_pilots",
                "latched_bypass"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "F3:signal_isolated",
              "value": true
            },
            {
              "type": "character_memory",
              "character_id": "npc:lingyin",
              "memory": "F3:kept_nutrient_path"
            }
          ]
        },
        {
          "id": "F3:separate_network:feed",
          "text": "保持养分通路，确认试送抵达育苗棚",
          "hint": "保留已接通的光路和养分通路；缺路时再照明、催生。养护机实际送达育苗棚才算完成。",
