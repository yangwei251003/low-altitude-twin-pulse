  "actions": [
    {
      "id": "I2:canal_service",
      "title": "把服务真正送到南湾",
      "region_id": "I2",
      "prerequisites": [
        "I2:distribution_audit"
      ],
      "target_minutes": [
        5,
        8
      ],
      "completion_text": "行动完成 · 南湾服务与双泵指令记录已保存。前往北部双泵检修台。",
      "objectives": [
        {
          "id": "I2:canal_service:brief",
          "text": "在南湾联络台核对需要运送的检修匣",
          "hint": "病房供水和桥位已经保存，不必重做。读取南湾工位请求，分清运输、测量与维修各自的完成条件。",
          "after": [],
          "events": [
            {
              "type": "inspect",
              "target_id": "I2:canal_briefing",
              "options": [
                "brief"
              ]
            }
          ],
          "effects": [
            {
              "type": "dialogue",
              "character_id": "npc:linlan",
              "lines": [
                "南湾不用重开水阀。先准备可用冷匣：退热换冷，或就地冷却工位上受撑的用匣。再完成扫描、标定和维修；病房支路保持原样。"
              ]
            }
          ]
        },
        {
          "id": "I2:canal_service:exchange",
          "text": "准备可用冷匣：实际换匣，或用热量工具完成就地冷却",
          "hint": "可沿高路或低路退热换冷并真实落架，也可对工位受撑的用匣施加热量工具，实际降至45℃或更低。已完成工序则保留原就地准备与真实扫描记录；不要求重新换匣，也不把就地冷却记作运输回执。载货时提早制动，让开岸柱。",
          "after": [
            "I2:canal_service:brief"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "I2:canal_exchange_verified",
              "options": [
                "high_route",
                "low_route",
                "mixed_route",
                "local_cooling"
              ]
            }
          ],
          "effects": [
            {
              "type": "character_memory",
              "character_id": "npc:ruanheng",
              "memory": "I2:real_cassette_exchange"
            },
            {
              "type": "dialogue",
              "character_id": "npc:ruanheng",
              "lines": [
                "工位冷匣状态和支撑已核对；把准备方法保存在记录里，接着完成实际扫描。"
              ]
            }
          ]
        },
        {
          "id": "I2:canal_service:service",
          "text": "在工位完成有效扫描、标定与维修",
          "hint": "若运输机尚未接单，先 Tab 锁定换匣运输机，选 0 机械接管并按 F 启动检修工单；再选 6 电荷，按 F 给检修台供电。扫描中可暂停和保存，恢复后继续余下扫描；完成后按 G 领取记录，重复读档不重复获得维修功劳。",
          "after": [
            "I2:canal_service:exchange"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "I2:canal_service_verified",
              "options": [
                "repaired"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "I2:canal_service_ready",
              "value": true
            },
            {
              "type": "discovery",
              "discovery_id": "I2:canal_calibration",
              "title": "南湾实际扫描与唯一维修工序信用"
            },
            {
              "type": "dialogue",
              "character_id": "npc:linlan",
              "lines": [
                "维修服务到位了。运水和巡检有了稳定工位，南湾不用再挤占病房的检修时间。"
              ]
            }
          ]
        },
        {
          "id": "I2:canal_service:order",
          "text": "读取工位收到的双泵优先级指令",
          "hint": "完成服务后近距读取调度记录。把机器实际收到的指令和现场去向并列记录，先不指认发送者。",
          "after": [
            "I2:canal_service:service"
          ],
          "events": [
            {
              "type": "inspect",
              "target_id": "I2:canal_dispatch",
              "options": [
                "record"
              ]
            }
          ],
          "effects": [
            {
              "type": "discovery",
              "discovery_id": "I2:pump_priority_order",
              "title": "双泵接受了重复的最高优先级指令"
            },
            {
              "type": "dialogue",
              "character_id": "npc:ruanheng",
              "lines": [
                "两座泵都被写成最高优先级，互锁才会反复抢占。停下守卫，我们可以改调度，保住两条服务线。"
              ]
            }
          ]
        }
      ],
      "effects": []
    },
    {
      "id": "I2:twin_pump_guardian",
      "title": "让双泵学会轮换",
      "region_id": "I2",
      "prerequisites": [
        "I2:canal_service"
      ],
      "target_minutes": [
        5,
        8
      ],
      "completion_text": "行动完成 · 水城调度由现场双方确认，镜湖航路开放。",
      "objectives": [
        {
          "id": "I2:twin_pump_guardian:plan",
          "text": "核对战区退路，确认停机方案",
          "hint": "守卫的低泵和高泵交替开罩。低水位先处理低泵，高水位先处理高泵；控制水位或借旁路接近都可。水城民用泵与战区隔离。",
          "after": [],
          "events": [
            {
              "type": "inspect",
              "target_id": "I2:boss_briefing",
              "options": [
                "plan"
              ]
            }
          ],
          "effects": [
            {
              "type": "dialogue",
              "character_id": "npc:ruanheng",
              "lines": [
                "守卫的低泵和高泵交替开罩。低水位先处理低泵，高水位先处理高泵；控制水位或借旁路接近都可。水城民用泵与战区隔离。"
              ]
            }
          ]
        },
        {
          "id": "I2:twin_pump_guardian:engage",
          "text": "进入战区，观察一次完整预警与恢复窗口",
          "hint": "离开安全台才会交战；先看形状、高度和可用掩体。倒地可救援，全灭可整场重试，不扣已有资产。",
          "after": [
            "I2:twin_pump_guardian:plan"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "I2:boss_observed",
              "options": [
                "observed"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "I2:boss_pattern_observed",
              "value": true
            }
          ]
        },
        {
          "id": "I2:twin_pump_guardian:stop",
          "text": "处理关键部件，停下失控核心",
          "hint": "按本区机制创造窗口；射击、能力和环境操作可组合。半血后重新观察节奏；结算保存成功才算停机。",
          "after": [
            "I2:twin_pump_guardian:engage"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "I2:boss_defeated",
              "options": [
                "committed"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "I2:boss_stopped",
              "value": true
            },
            {
              "type": "dialogue",
              "character_id": "npc:ruanheng",
              "lines": [
                "失控核心已停下，先保留它的运行记录。停机不能替我们决定接下来把支脉交给谁。"
              ]
            }
          ]
        },
        {
          "id": "I2:twin_pump_guardian:decision",
          "text": "确认病房优先或均衡轮换的水城调度",
          "hint": "先阅读两方案：病房优先保留应急储水，南湾补给较慢；均衡轮换同时补给，病房回储较慢。两者均保底供水、保留绕路；不是牺牲居民。单人确认，合作双方同意，确认前建立独立分支。",
          "after": [
            "I2:twin_pump_guardian:stop"
          ],
          "events": [
            {
              "type": "fact",
