  "scope_note": "行动数据与真实状态绑定契约。目标数量、5–8分钟均为制作预算；本文件不证明地区可玩、实体机制、趣味或体验时长。坐标需Root以默认镜头及真实碰撞核对。",
  "characters": [
    {
      "id": "npc:wenxu",
      "name": "闻序",
      "role": "离岸阵列值守员",
      "region_id": "I4",
      "greeting_lines": [
        "这套系统最初是为了让任何一边都不断供。它一直在补偿，却没人再问补偿从哪里来。"
      ],
      "replies": [
        {
          "after": "I4:prism_array:decision",
          "lines": [
            "行动完成 · 阵列控制权已按共同签署方案保存，前往冠峰汇合两界支脉。"
          ]
        }
      ]
    }
  ],
