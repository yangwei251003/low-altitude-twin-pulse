              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "F2:boss_pattern_observed",
              "value": true
            }
          ]
        },
        {
          "id": "F2:mirrorwing_warden:stop",
          "text": "处理关键部件，停下失控核心",
          "hint": "按本区机制创造窗口；射击、能力和环境操作可组合。半血后重新观察节奏；结算保存成功才算停机。",
          "after": [
            "F2:mirrorwing_warden:engage"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "F2:boss_defeated",
              "options": [
                "committed"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "F2:boss_stopped",
              "value": true
            },
            {
              "type": "dialogue",
              "character_id": "npc:shuyao",
              "lines": [
                "失控核心已停下，先保留它的运行记录。停机不能替我们决定接下来把支脉交给谁。"
              ]
            }
          ]
        },
        {
          "id": "F2:mirrorwing_warden:record",
          "text": "近距读取停机记录，核对下一段真实去向",
          "hint": "靠近核心侧记录台按 G；需看见目标。只有停机保存后才能读取；无需返回起点领奖。",
          "after": [
