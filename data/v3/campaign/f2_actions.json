  "actions": [
    {
      "id": "F2:mirror_evidence",
      "title": "镜面记录没有说完的话",
      "region_id": "F2",
      "prerequisites": [
        "I2:twin_pump_guardian"
      ],
      "target_minutes": [
        5,
        8
      ],
      "completion_text": "行动完成 · 校时与公开方案已留存。北庭可辨认真身的影子，前往停下镜翼巡守。",
      "objectives": [
        {
          "id": "F2:mirror_evidence:records",
          "text": "从不同高度读取两份相反的镜面记录",
          "hint": "一份在低湖檐，一份在上层悬庭；分别靠近按 G。倒影只提示路径，不能替代读取真实记录。",
          "after": [],
          "events": [
            {
              "type": "fact",
              "target_id": "F2:paired_records",
              "options": [
                "both_read"
              ]
            }
          ],
          "effects": [
            {
              "type": "discovery",
              "discovery_id": "F2:contradictory_records",
              "title": "停电与枯根的两份记录缺少同一段校时"
            },
            {
              "type": "dialogue",
              "character_id": "npc:shuyao",
              "lines": [
                "两份记录都是真的，却没有记同一段时间。别急着拿其中一份指认另一边。"
              ]
            }
          ]
        },
        {
          "id": "F2:mirror_evidence:archive",
          "text": "向疏谣核对缺失的校时与镜翼巡守",
          "hint": "档案守护者在西侧悬庭；靠近交谈。她能说明记录的来源，也会提醒你镜翼守卫的真身有固定投影。",
          "after": [
            "F2:mirror_evidence:records"
          ],
          "events": [
            {
              "type": "talk",
              "target_id": "npc:shuyao",
              "options": [
                "clock_gap"
              ]
            }
          ],
          "effects": [
            {
              "type": "character_memory",
              "character_id": "npc:shuyao",
              "memory": "F2:evidence_before_blame"
            },
            {
              "type": "dialogue",
              "character_id": "npc:shuyao",
              "lines": [
                "抽取开始前，校时曾被同一个中继延迟。巡守因此把两边都当成入侵者。把光路接回刻度石，缺失的时间会显出来。"
              ]
            }
          ]
        },
        {
          "id": "F2:mirror_evidence:light",
          "text": "转动导光镜，让光束照亮校时刻度石",
          "hint": "选光照并锁定镜体，施放后每次转动30°。可用原镜直达，或借东侧旁路镜把光再转回来；沿每段实际落点对齐接收石前面。中途遮挡会截断光路，对接收石直接发光不能替代。",
          "after": [
            "F2:mirror_evidence:archive"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "F2:clock_light_path",
              "options": [
                "manual_mirror",
                "takeover_mirror"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "F2:clock_path_restored",
              "value": true
            },
            {
              "type": "discovery",
              "discovery_id": "F2:aligned_timeline",
              "title": "两界失流与上游配额覆盖处于同一条时间线"
            }
          ]
        },
        {
          "id": "F2:mirror_evidence:decision",
          "text": "决定立即公开原始证据，或附校时说明共同发布",
          "hint": "立即公开：两界居民马上看到原件，疏谣须处理未校时的争议；共同发布：阮衡与疏谣先补说明，延后本区公告。原件始终保留，不销毁、不封锁后续调查。联机双方确认，提交前建立分支。",
          "after": [
            "F2:mirror_evidence:light"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "F2:chapter_choice",
              "options": [
                "publish_raw",
                "publish_context"
              ]
            }
          ],
          "effects": [
            {
              "type": "flag",
              "key": "F2:chapter_decision_saved",
              "value": true
            },
            {
              "type": "character_memory",
              "character_id": "npc:shuyao",
              "memory": "F2:publication_consent"
            },
            {
              "type": "dialogue",
              "character_id": "npc:shuyao",
              "lines": [
                "原件会留下。我们记住怎样公开，也记住谁需要把遗漏的解释补上。现在去让巡守停下来，别让它继续攻击过路人。"
              ]
            }
          ]
        }
      ],
      "effects": []
    },
    {
