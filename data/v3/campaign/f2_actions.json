          "effects": [
            {
              "type": "dialogue",
              "character_id": "npc:shuyao",
              "lines": [
                "巡守会留下两个镜像。先选4光照，Tab锁定辨真光源后按F，让真身挡住通往背光传感面的光束，形成真实投影；验证后，恢复窗口的真翼才会开放。再绕到无遮挡的一侧射击，不要向镜像浪费火力。"
              ]
            }
          ]
        },
        {
          "id": "F2:mirrorwing_warden:engage",
          "text": "进入战区，观察一次完整预警与恢复窗口",
          "hint": "离开安全台才会交战；先看形状、高度和可用掩体。倒地可救援，全灭可整场重试，不扣已有资产。",
          "after": [
            "F2:mirrorwing_warden:plan"
          ],
          "events": [
            {
              "type": "fact",
              "target_id": "F2:boss_observed",
              "options": [
