{
  "schema_version": 1,
  "content_id": "opening_v1",
  "title": "断流之后",
  "scope_note": "首段四行动、十五目标单元。5–8分钟是每行动的设计目标，尚未通过人玩计时；不代表八区主线、NPC人物模型或10–15小时内容完成。",
  "characters": [
    {
      "id": "npc:linlan", "name": "林岚", "role": "港口救援调度", "region_id": "I1",
      "greeting_lines": ["桥面的检修无人机失去联络了。先接通它，我来安排南岸接应。"],
      "replies": [
        {"after": "I1:rescue:brief", "lines": ["供电、热旁路、接管控制台都能试。你也可以从上方绕过去，别为开门冒不必要的险。"]},
        {"after": "I1:rescue:contact", "lines": ["听到检修机的信标了。它还能自己返航，把南岸的安全路线传回来。"]},
        {"after": "I1:rescue:evacuate", "lines": ["接应点收到指引。检修机已切回返航程序，谢谢。", "还有一件事：断电前，港口电表反而在向外倒转。阮衡守着那段线路。"]},
        {"after": "F1:repair:confirm", "lines": ["港口的应急灯稳定了，另一边也保住了育苗棚。", "这只是这一段支路。是谁让两边互相失血，我们继续查。"]}
      ]
    },
    {
      "id": "npc:ruanheng", "name": "阮衡", "role": "港口值班工程师", "region_id": "I1",
      "greeting_lines": ["这条线还连着居民区的应急电。要检查可以，别把总闸直接拔掉。"],
      "replies": [
        {"after": "I1:evidence:trace", "lines": ["烧痕朝着港外，不像普通过载。你找到的回流痕迹，和我的记录对上了。"]},
        {"after": "I1:evidence:engineer", "lines": ["桥面记录匣里有断流前的方向记录。先看清流向，再决定改哪条线。"]},
        {"after": "I1:evidence:ledger", "lines": ["港口没有收到这笔能量，它被更远的阵列截走了。东岸信标能追到另一端。"]},
        {"after": "F1:repair:plan", "lines": ["不切总线。先让另一边的光路自行供养，再把本地支路设成双向限流。"]},
        {"after": "F1:repair:confirm", "lines": ["局部回流已经停止。阵列上的异常指令还在；下一步需要它的原始记录。"]}
      ]
    },
    {
      "id": "npc:atai", "name": "阿苔", "role": "根谷守林人", "region_id": "F1",
      "greeting_lines": ["你的机器发出和断流前一样的鸣声。先别取走这里的光，我们还要靠它养活幼根。"],
      "replies": [
        {"after": "F1:needs:listen", "lines": ["南边育苗棚的根正在干枯。你可以自己看，再决定要不要帮忙。"]},
        {"after": "F1:needs:nursery", "lines": ["东岸的根台还能接住光。从空中过去也行，借枝桥或折跃也行，不必折断活根。"]},
        {"after": "F1:needs:route", "lines": ["原来你们的应急灯也靠同一条脉络。争着抽干它，最后两边都会暗下来。"]},
        {"after": "F1:repair:plan", "lines": ["先把环上的光导回幼根，再让枝桥接起来。等根能自己供养，我们才改支路。"]},
        {"after": "F1:repair:grow", "lines": ["枝桥恢复了。我会照料这段根，你去东岸接口检查两边的读数。"]},
        {"after": "F1:repair:confirm", "lines": ["幼根重新有了光。这次你带来的是一条活路。", "北面的老根仍在失血；这股抽取不是从港口结束的。"]}
      ]
    }
  ],
