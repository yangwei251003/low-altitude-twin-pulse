          "events":[{"type":"fact","target_id":"F1:light_receiver","options":["aligned"]}],
          "effects":[{"type":"flag","key":"opening:light_route_observed","value":true},{"type":"dialogue","character_id":"npc:atai","lines":["光接上了。让幼根顺着这条亮路生长；如果被挡住，先恢复光路。"]}]
        },
        {
          "id":"F1:repair:grow", "text":"催生幼根，接起可承重的枝桥", "hint":"保持光路有效，对幼根使用生长；枝桥形成碰撞通路后自动确认。", "after":["F1:repair:light"],
          "events":[{"type":"fact","target_id":"F1:growth_bridge","options":["grown"]}],
          "effects":[{"type":"flag","key":"opening:living_bridge_restored","value":true},{"type":"dialogue","character_id":"npc:atai","lines":["枝桥接起来了。它留在这里，后来的人也能用。", "请到东岸支路接口检查读数，我看着这边的幼根。"]}]
        },
        {
          "id":"F1:repair:confirm", "text":"检查东岸接口，核对两界局部回流停止", "hint":"枝桥与光路恢复后检查接口。核对后，先对身旁跨界信标使用机械接管，或给本地继电器供电，再点“提交通航修复”。这只修复本地支路，上游抽取仍待追查。", "after":["F1:repair:grow"],
          "events":[{"type":"inspect","target_id":"F1:shared_junction","options":[""]}],
          "effects":[{"type":"dialogue","character_id":"npc:ruanheng","lines":["本地回流止住了，应急灯也稳定下来。先回北港截停鲸机，取出它收到的原始指令，再追老根上的抽取来源。"]},{"type":"dialogue","character_id":"npc:atai","lines":["幼根亮了。我在根道等你们的记录；查清指令，才能知道该改哪一段脉络。"]},{"type":"character_memory","character_id":"npc:atai","memory":"opening:repair_partner"},{"type":"character_memory","character_id":"npc:linlan","memory":"opening:both_shores_answered"}]
        }
      ],
      "effects":[{"type":"flag","key":"opening:local_repair_completed","value":true},{"type":"discovery","discovery_id":"opening:shared_repair_record","title":"第一条共同修复的支路与仍在抽取的上游阵列"}]
