        {
          "id":"I1:evidence:trace", "text":"检查继电器旁的反向烧蚀痕迹", "hint":"烧痕指向港外；靠近线路按交互键读取。", "after":[],
          "events":[{"type":"inspect","target_id":"I1:burn_trace","options":[""]}],
          "effects":[{"type":"discovery","discovery_id":"opening:reverse_burn","title":"烧蚀方向与普通过载相反"},{"type":"dialogue","character_id":"npc:ruanheng","lines":["对，这不是简单断电。电荷离开了港口，却没有经过我们的配电支路。"]}]
        },
        {
          "id":"I1:evidence:engineer", "text":"向阮衡核实回流与居民供电的关系", "hint":"工程联络台在继电器附近；了解为什么不能直接切断总线。", "after":["I1:evidence:trace"],
          "events":[{"type":"talk","target_id":"npc:ruanheng","options":["reverse_flow"]}],
          "effects":[{"type":"character_memory","character_id":"npc:ruanheng","memory":"opening:kept_emergency_power"},{"type":"dialogue","character_id":"npc:ruanheng","lines":["拔掉总线能止住回流，也会熄掉居民区的应急灯。", "桥面的记录匣留着断流前的流向，先找出是谁在抽走能量。"]}]
        },
        {
          "id":"I1:evidence:ledger", "text":"登上桥面读取断流前的流向记录", "hint":"记录匣在桥面侧翼；飞行升高，留意卷帘与桥框。", "after":["I1:evidence:engineer"],
          "events":[{"type":"inspect","target_id":"I1:energy_ledger","options":[""]}],
          "effects":[{"type":"discovery","discovery_id":"opening:extraction_record","title":"能量被更远的共振阵列截走"},{"type":"dialogue","character_id":"npc:ruanheng","lines":["记录里有第三个接收端。港口没拿到这笔能量，另一边恐怕也一样。", "东岸信标还保留着来路的回声。"]}]
        },
        {
          "id":"I1:evidence:echo", "text":"在东岸信标辨认另一界的求援回声", "hint":"检查信标回声，随后可与同伴共同前往巨木神殿。", "after":["I1:evidence:ledger"],
          "events":[{"type":"inspect","target_id":"I1:beacon_echo","options":[""]}],
          "effects":[{"type":"dialogue","character_id":"npc:atai","lines":["……幼根又暗了。听得见吗？别再抽走这段脉络里的光。"]}]
        }
      ],
      "effects":[{"type":"flag","key":"opening:crossing_known","value":true},{"type":"discovery","discovery_id":"opening:other_shore_call","title":"巨木居民也在承受断流"}]
    },
