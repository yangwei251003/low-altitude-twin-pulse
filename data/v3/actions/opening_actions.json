      "completion_text":"行动完成 · 找到了能接光的东岸育根台。\n接通阿苔和阮衡，商量两岸都能用的修复办法。",
      "objectives":[
        {
          "id":"F1:needs:listen", "text":"听阿苔说明幼根与居民的需要", "hint":"守林联络处在神殿西南；交互了解对方为什么不愿让出光。", "after":[],
          "events":[{"type":"talk","target_id":"npc:atai","options":["needs"]}],
          "effects":[{"type":"character_memory","character_id":"npc:atai","memory":"opening:listened_before_taking"},{"type":"dialogue","character_id":"npc:atai","lines":["这里不是一座给机器充电的空殿。幼根要靠这道光活过旱季，根下还住着人。", "去看南侧的育苗棚。看过以后，我们再谈你们的需要。"]}]
        },
        {
          "id":"F1:needs:nursery", "text":"检查失光幼根，辨认尚存的生长方向", "hint":"检查幼根留下的亮纹；它们朝东岸仍活着的根台延伸。", "after":["F1:needs:listen"],
          "events":[{"type":"inspect","target_id":"F1:dry_nursery","options":[""]}],
          "effects":[{"type":"discovery","discovery_id":"opening:nursery_dependency","title":"根谷生活与港口应急灯依赖同一支脉"},{"type":"dialogue","character_id":"npc:atai","lines":["根没有死，东岸还留着能接光的一段。先找到那块根台，我们一起看清能救什么。"]}]
        },
        {
          "id":"F1:needs:route", "text":"选择路线抵达东岸育根台", "hint":"自由飞行、沿已生长的枝桥、或用短距折跃接近；抵达后自动记录。", "after":["F1:needs:nursery"],
          "events":[{"type":"reach","target_id":"F1:nursery_landing","options":["flight","growth","blink"]}],
          "effects":[{"type":"flag","key":"opening:nursery_route_known","value":true},{"type":"dialogue","character_id":"npc:atai","lines":["就是这里。你们不是唯一失去光的人，我们也不能只顾自己。", "我在西岸联络处。让你们的工程师一起听，我们试着保住两边。"]}]
        }
      ],
      "effects":[{"type":"character_memory","character_id":"npc:atai","memory":"opening:saw_living_roots"},{"type":"flag","key":"opening:shared_need_understood","value":true}]
    },
    {
      "id":"F1:repair", "title":"让支脉先活下来", "region_id":"F1", "prerequisites":["F1:needs"], "target_minutes":[5,8],
      "completion_text":"行动完成 · 光路与枝桥已恢复，局部回流停止。\n在东岸信标提交本区通航修复，按 M 回潮湾北港，再联络阮衡截停鲸机。",
      "objectives":[
