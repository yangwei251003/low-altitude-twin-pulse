  "actions": [
    {
      "id":"I1:rescue", "title":"先接回失联的声音", "region_id":"I1", "prerequisites":[], "target_minutes":[5,8],
      "completion_text":"行动完成 · 检修机已恢复返航。\n发现能量倒流；沿继电器旁的烧痕查原因。",
      "objectives":[
        {
          "id":"I1:rescue:brief", "text":"接听林岚的救援呼叫", "hint":"南岸救援无线电处按交互键；检修无人机停在桥后高处。", "after":[],
          "events":[{"type":"talk","target_id":"npc:linlan","options":["rescue_brief"]}],
          "effects":[{"type":"dialogue","character_id":"npc:linlan","lines":["检修机困在桥后。开闸可以恢复常规通道，你也能从上方绕过去接通它。", "南岸由我接应；先找到它，别急着追事故原因。"]},{"type":"character_memory","character_id":"npc:linlan","memory":"opening:accepted_rescue"}]
        },
        {
          "id":"I1:rescue:channel", "text":"建立桥后救援通路", "hint":"供能、加热旁路或接管开闸；也可从上方飞到桥后高处。", "after":["I1:rescue:brief"],
          "events":[{"type":"fact","target_id":"I1:rescue_channel","options":["charge","heat","takeover","aerial"]}],
          "effects":[{"type":"flag","key":"opening:rescue_channel_known","value":true},{"type":"dialogue","character_id":"npc:linlan","lines":["你已经找到可接近的路线。靠近桥后检修机，重新握手它的信标。"]}]
        },
        {
          "id":"I1:rescue:contact", "text":"靠近桥后的检修无人机，恢复联络", "hint":"目标在桥面以上，不在桥下；接近后自动连接。", "after":["I1:rescue:channel"],
          "events":[{"type":"reach","target_id":"I1:rescue_pocket","options":[""]}],
          "effects":[{"type":"flag","key":"opening:rescue_contact","value":true},{"type":"dialogue","character_id":"npc:linlan","lines":["信标回来了，它还能自行返航。请飞到南岸航标，给它确认最后一段安全路线。"]}]
        },
        {
          "id":"I1:rescue:evacuate", "text":"抵达南岸航标，完成撤离联络", "hint":"返回河湾南侧接应点；无需搬运无人机或人员。", "after":["I1:rescue:contact"],
          "events":[{"type":"reach","target_id":"I1:rescue_exit","options":[""]}],
          "effects":[{"type":"character_memory","character_id":"npc:linlan","memory":"opening:route_confirmed"},{"type":"dialogue","character_id":"npc:linlan","lines":["接应点收到，检修机已恢复返航程序。", "刚才的停电不对劲：沿继电器旁那段烧黑的线看看。"]}]
        }
      ],
      "effects":[{"type":"flag","key":"opening:rescue_completed","value":true},{"type":"discovery","discovery_id":"opening:rescue_log","title":"一场伴随能量倒流的事故"}]
    },
    {
