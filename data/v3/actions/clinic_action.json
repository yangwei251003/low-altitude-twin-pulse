    {"id": "I2:clinic_water_check", "region": "I2", "position": [7, 5.8, -3], "kind": "inspect", "label": "下层病房 · 恢复确认", "radius": 3}
  ],
  "actions": [
    {
      "id": "I2:clinic_supply",
      "title": "接回下层病房",
      "completion_text": "行动完成 · 病房供水与齐平通路已确认并保存。\n配流失序的线索已留存，无需返回港口领奖。",
      "region_id": "I2",
      "prerequisites": ["I1:underdeck"],
      "target_minutes": [5, 8],
      "objectives": [
        {
          "id": "I2:clinic_supply:diagnose",
          "text": "到下层病房核对缺水与断开的通路",
          "hint": "靠近病房检查点，保持无遮挡视线，按 G 核对病房箱、水源和浮台。上层储备罐仍有清水；核对原先断开的配流关系，不需要回港口找材料。",
          "after": [],
          "events": [{"type": "fact", "target_id": "I2:clinic_demand", "options": ["identified"]}],
          "effects": [
            {"type": "dialogue", "character_id": "npc:linlan", "lines": ["下层病房要恢复接诊，先让供水接上，也让担架能平稳过这段断口。高处的储备罐还有清水，问题不在水源耗尽。", "不用先回来交差。就在病房核对，接通之后也在这里确认。"]},
            {"type": "dialogue", "character_id": "npc:ruanheng", "lines": ["有两条现成路线：飞到高罐旁，沿轨道推动机械滑阀；或者从低层南门进泵室，给继电器充能，再接管选择阀。", "选择阀要走满行程才通水；高阀还开着时，互锁会等它回闭端。看实际阀位和灯，不必两人同时操作。"]}
          ]
        },
        {
          "id": "I2:clinic_supply:connect",
          "text": "选高位机械旁路或低层电泵，接通病房进水",
          "hint": "高位路线用推拉让滑阀真正到开端；低层路线给继电器充能，再接管选择阀完成行程。水实际从清水罐进入病房箱才算接通，两条路线只记一次成果。",
          "after": ["I2:clinic_supply:diagnose"],
          "events": [{"type": "fact", "target_id": "I2:clinic_feed", "options": ["gravity", "pump"]}],
          "effects": [
            {"type": "dialogue", "character_id": "npc:ruanheng", "lines": ["清水确实进入病房箱了。高处旁路利用高低水位，低处电泵靠继电器供能；我们留下实际用过的接法，不重复计功。", "现在可以返回病房看水位和浮台。让开台面及连杆的上升范围；有东西挡住，进水会暂停等通路清空。"]}
          ]
        },
        {
          "id": "I2:clinic_supply:stabilize",
          "text": "确认进水止住，浮台与两岸通路齐平",
          "hint": "观察病房箱水位与浮台，不必守在阀边。达到本次供水量后入口自动止水；台面和两端通路都稳定，才进入最后核对。受阻时先清空上升范围。",
          "after": ["I2:clinic_supply:connect"],
          "events": [{"type": "fact", "target_id": "I2:clinic_water_ready", "options": ["verified"]}],
          "effects": [
            {"type": "dialogue", "character_id": "npc:linlan", "lines": ["水位停住了，浮台也与两边接平。居民走的是这条通路，飞过去看起来能过，还不等于担架能过。", "靠近病房检查点再按 G，把眼前的供水和通路一起核对并留下记录。"]}
          ]
        },
        {
          "id": "I2:clinic_supply:confirm",
          "text": "在病房就地确认恢复，留存配流失序的线索",
          "hint": "靠近病房恢复确认点，保持无遮挡视线，按 G。会重新核对水量、止水和实际通路；保存成功后才宣布服务恢复，不需要再抽一轮水。",
          "after": ["I2:clinic_supply:stabilize"],
          "events": [{"type": "fact", "target_id": "I2:clinic_water_check", "options": ["commissioned"]}],
          "effects": [
            {"type": "flag", "key": "I2:clinic_ready", "value": true},
            {"type": "discovery", "discovery_id": "I2:clinic_priority_misroute", "title": "储备罐有水，病房支路却断开：配流失序影响了居民接诊与通行"},
            {"type": "character_memory", "character_id": "npc:ruanheng", "memory": "I2:clinic_restored_patient_access"},
            {"type": "dialogue", "character_id": "npc:ruanheng", "lines": ["储备没有空，病房的配流却断了；这条记录能说明失序影响到了哪里，还不能说明是谁做的。", "接回水，也接平居民要走的路，这次修复才算落到了用处上。我会把你采用的接法一并记住。"]},
            {"type": "dialogue", "character_id": "npc:linlan", "lines": ["病房这段供水和通路已经确认，记录也保存了。你们可以继续在水城查看，不用为领奖再飞回港口。"]}
          ]
        }
      ],
      "effects": []
    }
  ],
