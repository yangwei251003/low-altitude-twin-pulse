  "title": "潮下检修孔",
  "status": "integrated_development_candidate",
  "scope_note": "第七行动四个目标，按 opening_v1、whale、crown、underdeck 顺序合并，共七行动二十七目标。房主适配器观察真实机体穿面及连续控制，再经现有行动事务保存和同步。潮下是干式检修层名称，不表示已实现潮汐或潜水。5–8分钟仅为待真人验证的首次体验目标，不靠延长循环或强制返航凑时长。",
  "requires_action_ids": ["F1:crown"],
  "requires_character_ids": ["npc:ruanheng"],
  "characters": [],
  "markers": [
    {
      "id": "I1:underdeck_log",
      "region": "I1",
      "position": [-34, 1.6, -16.7],
