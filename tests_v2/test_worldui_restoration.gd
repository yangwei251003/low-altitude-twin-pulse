extends SceneTree
## Transaction/appearance fixture only. It deliberately seeds the completed-action boundary.
## Actual Runner._finish_stage -> stage_ready -> Session -> repository fault/retry chain.
## It does NOT prove mission gameplay, player input, GPU rendering, or flight performance.

const World = preload("res://scripts/v2/region_world.gd")
const Repository = preload("res://scripts/v2/save_repository.gd")
class IsolatedSession:
	extends "res://scripts/v2/session.gd"
	var fixture_path = ""
	func _ready() -> void:
		process_mode = Node.PROCESS_MODE_ALWAYS
		qa_mode = true
		content = CatalogV2.content()
		profiles = ProfileCatalogV22.new(fixture_path+"/profiles",fixture_path+"/nonexistent_legacy_source")
		profiles.initialize()
		repository = profiles.open_profile("default")
		repository.commit({"id":"ui-smoke:init","set":{"settings.fullscreen":false,"settings.mute":true,"settings.auto_fire":false}})
		active_build = selected_build()
		selected_frame = str(active_build.airframe_id)
		input = PilotInputV2.new()
		add_child(input)
		input.configure_input(repository.data.settings.get("input",{}))
		input.pause_requested.connect(func(reason): pause_game(reason))
		phone = PhoneServerV2.new()
		add_child(phone)
		phone.status_changed.connect(_phone_changed)
		_setup_view()
		ui = GameInterfaceV2.new()
		ui.session = self
		add_child(ui)
		if ResourceLoader.exists("res://scripts/v2/tutorial_director.gd"):
			tutorial = load("res://scripts/v2/tutorial_director.gd").new()
			add_child(tutorial)
			tutorial.configure(self)
		apply_settings()
		show_hangar()


var game: IsolatedSession
var fixture_root = ""
var checks = 0
var failures: Array[String] = []
var case_count = 0
var finish_signals = 0

func _initialize() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--restoration-root="): fixture_root=arg.trim_prefix("--restoration-root=").replace("\\","/").simplify_path()
	var temp_root=OS.get_environment("TEMP").replace("\\","/").simplify_path().trim_suffix("/")+"/"
	if DisplayServer.get_name()!="headless" or fixture_root.is_empty() or not fixture_root.is_absolute_path() or not fixture_root.to_lower().begins_with(temp_root.to_lower()) or DirAccess.dir_exists_absolute(fixture_root):
		printerr("Requires headless and a fresh absolute --restoration-root=<Windows Temp subdirectory>.")
		quit(2); return
	call_deferred("run")

func check(value: bool, message: String) -> void:
	checks+=1
	if not value: failures.append(message)
	print("RESTORATION_TX_CHECK ",JSON.stringify({"pass":value,"check":message}))

func settle(frames=4) -> void:
	for ignored in frames: await process_frame

func reset_case() -> void:
	paused=false
	if is_instance_valid(game): game.queue_free(); await settle()
	case_count+=1
	game=IsolatedSession.new(); game.fixture_path=fixture_root+"/case_"+str(case_count)
	root.add_child(game); await settle()
	game.set_physics_process(false)

func fixture_launch(job_id: String, stage_number=0, practice=false, optional=false) -> void:
	await reset_case()
	var missions: Array=[]
	var stages: Array=[]
	if job_id.begins_with("M"):
		for job in game.content.missions:
			if str(job.id)<job_id:
				missions.append(job.id)
				for stage in job.stages: stages.append(stage.id)
		for i in stage_number: stages.append(game.get_job(job_id).stages[i].id)
	var checkpoint={"layout_revision":1,"job_id":job_id,"stage_index":stage_number,"run_id":"restoration-fixture-"+str(case_count),"seconds":0,"repeat":false,"night":true}
	var seed=game.repository.commit({"id":"fixture:entry","set":{"campaign.completed_missions":missions,"campaign.completed_stages":stages,"campaign.active_checkpoint":checkpoint if job_id.begins_with("M") else null}})
	check(bool(seed.get("ok",false)),job_id+" explicit isolated entry fixture commits")
	if practice:
		game.launch_tutorial_practice(job_id)
		game.stage_index=stage_number
		game.runner.start_stage(game.current_job.stages[stage_number])
	else:
		game.launch_job(job_id,true)
	if optional: game.runner.start_stage(game.current_job.stages[stage_number],true)
	check(game.flight_active and is_instance_valid(game.runner),job_id+" actual Session constructed Runner")
	game.pilot.freeze=true; game.runner.set_physics_process(false); game.combat.set_physics_process(false)
	game.runner.stage_ready.connect(func(_stage): finish_signals+=1)
	await settle()

func seed_completed_action_boundary() -> Array:
	# This fixture does not claim actions were performed. It tests publication timing,
	# using the actual IDs generated by the same action types as _complete_action.
	var expected: Array=[]
	game.runner.staged_restorations.clear()
	for action in game.runner.actions:
		if str(action.type) in ["scan","clear","deliver","interact"] and str(action.poi_id) not in expected:
			expected.append(str(action.poi_id)); game.runner.staged_restorations.append(str(action.poi_id))
	game.runner.action_index=game.runner.actions.size()
	game.runner.pending=false
	var requirements: Dictionary=game.runner.stage.get("completion_metrics",{})
	for key in requirements:
		var name=str(key)
		if name.ends_with("_min"):
			var metric=name if game.runner.metrics.has(name) else name.trim_suffix("_min")
			game.runner.metrics[metric]=float(requirements[key])
		elif name.ends_with("_max"): game.runner.metrics[name.trim_suffix("_max")]=0
	return expected

func lamp_signature(world) -> Array:
	var result: Array=[]
	for lamp in world.route_lamps:
		if is_instance_valid(lamp) and lamp.material_override is StandardMaterial3D:
			var mat: StandardMaterial3D=lamp.material_override
			result.append([mat.albedo_color.to_html(),mat.emission_energy_multiplier])
	return result

func verify_restored_display(world, restored: bool, label: String, inspect_pools=false) -> void:
	check(bool(world.get_meta("facility_recovered",false))==restored,label+" scene recovery metadata")
	var lamps=lamp_signature(world)
	check(not lamps.is_empty(),label+" actual navigation lamp meshes exist")
	var color=Color("96cfb4" if restored else "b9a065").to_html()
	var glow=1.3 if restored else .5
	check(lamps.all(func(item): return item[0]==color and is_equal_approx(float(item[1]),glow)),label+" every navigation lamp material matches saved state")
	if inspect_pools:
		check(not world.facility_lights.is_empty(),label+" actual night light pools exist")
		check(world.facility_lights.all(func(light): return is_equal_approx(light.light_energy,.65 if restored else .18)),label+" actual night pool energies match saved state")

func reenter_from_disk(expected_ids: Array, recovered: bool, label: String) -> void:
	var loaded=Repository.new(game.repository.root_path)
	check(loaded.load_profile(),label+" saved generation reopens")
	for id in expected_ids: check(bool(loaded.data.world.restored_objects.get(id,false))==recovered,label+" disk restoration "+str(id))
	var rebuilt=World.new()
	rebuilt.configure(game.get_region(game.region_id),true,loaded.data.world)
	root.add_child(rebuilt)
	await settle(2)
	var regional_recovery=false
	for id in rebuilt.layout.get("restoration_pois",[]):
		if bool(loaded.data.world.restored_objects.get(id,false)): regional_recovery=true
	verify_restored_display(rebuilt,regional_recovery,label+" rebuilt night world",true)
	rebuilt.queue_free(); await settle(2)

func test_formal(job_id: String, stage_number: int) -> void:
	await fixture_launch(job_id,stage_number)
	var stage: Dictionary=game.current_job.stages[stage_number]
	var staged=seed_completed_action_boundary()
	var expected: Array=stage.poi_ids.duplicate()
	if job_id=="M13" and stage_number==0:
		check("R4-P03" in staged and "R4-P03" not in expected,"M13-S1 scans P03 but authoritative stage list deliberately excludes its repair")
	verify_restored_display(game.world,false,job_id+" before completion")
	var before_lamps=lamp_signature(game.world)
	var parts=int(game.repository.data.wallet.parts)
	var signals_before=finish_signals
	game.repository.failure_point="before_write"
	game.runner._finish_stage()
	check(finish_signals==signals_before+1,job_id+" actual Runner emits stage_ready once")
	check(game.pause_reasons.has("save_error") and not game.pending_transaction.is_empty(),job_id+" real stage transaction enters retryable write failure")
	check(game.stage_index==stage_number and int(game.repository.data.wallet.parts)==parts,job_id+" failed transaction neither advances nor pays")
	for id in expected:
		check(not bool(game.world.restored.get(id,false)) and not bool(game.repository.data.world.restored_objects.get(id,false)),job_id+" failed transaction keeps scene and save unrecovered "+str(id))
	check(lamp_signature(game.world)==before_lamps,job_id+" failed transaction does not alter any real lamp")
	verify_restored_display(game.world,false,job_id+" failed save")
	var retry_tx=game.pending_transaction.duplicate(true)
	game.repository.failure_point=""
	game.retry_save()
	for id in expected:
		check(bool(game.world.restored.get(id,false)) and bool(game.repository.data.world.restored_objects.get(id,false)),job_id+" successful retry restores both authorities "+str(id))
	var regional_recovery=false
	for id in game.world.layout.get("restoration_pois",[]):
		if str(id) in expected: regional_recovery=true
	verify_restored_display(game.world,regional_recovery,job_id+" successful retry")
	if job_id=="M13":
		var p03_expected=stage_number==2
		check(bool(game.world.restored.get("R4-P03",false))==p03_expected and bool(game.repository.data.world.restored_objects.get("R4-P03",false))==p03_expected,"M13 P03 repair follows S3, never S1 scan")
	var rewarded=int(game.repository.data.wallet.parts)
	check(rewarded==parts+int(stage.first_reward_parts),job_id+" retry pays exactly the stage reward")
	var replay=game.repository.commit(retry_tx)
	check(bool(replay.get("duplicate",false)) and int(game.repository.data.wallet.parts)==rewarded,job_id+" duplicate transaction cannot pay again")
	game.retry_save()
	check(int(game.repository.data.wallet.parts)==rewarded,job_id+" empty repeated retry has no effect")
	await reenter_from_disk(expected,true,job_id)
	if job_id=="M13":
		var loaded=Repository.new(game.repository.root_path)
		check(loaded.load_profile(),"M13 P03 negative/positive fixture reopens")
		check(bool(loaded.data.world.restored_objects.get("R4-P03",false))==(stage_number==2),"M13 P03 stage-specific repair survives disk reopen")

func test_temporary_success(kind: String) -> void:
	var practice=kind=="practice"
	var optional=kind=="optional"
	await fixture_launch("M01" if practice else ("M03" if optional else "C-TR01-02"),1 if practice else (2 if optional else 0),practice,optional)
	var expected=seed_completed_action_boundary()
	check(not expected.is_empty(),kind+" real action set has temporary restoration targets")
	var before=JSON.stringify(game.repository.data)
	var parts=int(game.repository.data.wallet.parts)
	var before_lamps=lamp_signature(game.world)
	if not practice: game.repository.failure_point="before_write"
	var signals_before=finish_signals
	game.runner._finish_stage()
	check(finish_signals==signals_before+1,kind+" actual Runner signal reaches Session")
	if not practice:
		check(game.pause_reasons.has("save_error") and not game.pending_transaction.is_empty(),kind+" reward write failure is retryable")
		for id in expected: check(not bool(game.world.restored.get(id,false)),kind+" failed reward cannot publish temporary restoration "+str(id))
		check(lamp_signature(game.world)==before_lamps,kind+" failed reward leaves lights unchanged")
		check(int(game.repository.data.wallet.parts)==parts,kind+" failed reward does not pay")
		game.repository.failure_point=""; game.retry_save()
	for id in expected:
		check(bool(game.world.restored.get(id,false)),kind+" success retains former temporary scene restoration "+str(id))
		check(not bool(game.repository.data.world.restored_objects.get(id,false)),kind+" success does not turn temporary effects into campaign repair "+str(id))
	if practice: check(JSON.stringify(game.repository.data)==before,kind+" temporary scene effect leaves every saved field unchanged")
	else:
		var reward=int(game.current_job.get("optional_delivery_parts",0)) if optional else int(game.current_job.get("first_reward_parts",60))
		check(int(game.repository.data.wallet.parts)==parts+reward,kind+" successful reward transaction pays once")
	await reenter_from_disk(expected,false,kind)

func run() -> void:
	root.content_scale_size=Vector2i.ZERO; root.size=Vector2i(1280,720)
	for item in [["M01",1],["M05",2],["M09",2],["M13",0],["M13",2]]: await test_formal(str(item[0]),int(item[1]))
	for kind in ["practice","optional","side_job"]: await test_temporary_success(kind)
	paused=false
	if is_instance_valid(game): game.queue_free(); await settle()
	var report={"suite":"worldui_restoration_transactions","checks":checks,"failed":failures.size(),"failures":failures,"cases":case_count,"finish_signals":finish_signals,"fixture_root":fixture_root,"scope":"Headless actual Runner._finish_stage -> stage_ready -> Session save failure/retry; explicitly seeded completed-action boundary, native scene materials/lights, disk reload and rebuilt night worlds. NOT gameplay completion, GPU, physical input, flight route or performance evidence."}
	var file=FileAccess.open(fixture_root+"/summary.json",FileAccess.WRITE)
	if file: file.store_string(JSON.stringify(report,"  ")); file.close()
	print("RESTORATION_TX_SUMMARY ",JSON.stringify(report))
	quit(0 if failures.is_empty() else 1)
